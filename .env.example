# BatteryScientist (OpenAI-compatible endpoint)
BATTERYSCIENTIST_API_KEY=your-api-key
BATTERYSCIENTIST_BASE_URL=https://www.micuapi.ai/v1
BATTERYSCIENTIST_MODEL=gpt-6-astra
BATTERYSCIENTIST_REVIEW_MODEL=gpt-6-astra
BATTERYSCIENTIST_REVIEW_REASONING_EFFORT=xhigh
# Optional when the reviewer executable is not on PATH.
# CODEX_BIN=/absolute/path/to/codex
# Optional per-response output budget; must be supported by the API provider.
# BATTERYSCIENTIST_MAX_TOKENS=32768

# Optional image generation
BATTERYSCIENTIST_IMAGE_API_KEY=your-api-key
BATTERYSCIENTIST_IMAGE_BASE_URL=https://www.micuapi.ai/v1
BATTERYSCIENTIST_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional MinerU full-text, figure and caption parsing for local papers.
# Isolated MinerU 4.x environment; otherwise discover mineru-kit on PATH.
# BATTERYSCIENTIST_MINERU_PYTHON=/path/to/mineru-venv/bin/python
# MINERU_HOME=/path/to/mineru/home
BATTERYSCIENTIST_MINERU_TIMEOUT=1200

# Optional offline Wiki semantic retrieval (no automatic model download at runtime).
# Without these settings, Wiki retrieval uses BM25 with Chinese tokenization.
BATTERYSCIENTIST_EMBEDDING_DIR=
BATTERYSCIENTIST_EMBEDDING_PYTHON=
# BATTERYSCIENTIST_EMBEDDING_CACHE=/data/wiki-embedding-cache
