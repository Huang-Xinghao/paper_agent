# Paper Agent (OpenAI-compatible endpoint)
PAPER_AGENT_API_KEY=your-api-key
PAPER_AGENT_BASE_URL=https://www.micuapi.ai/v1
PAPER_AGENT_MODEL=gpt-6-astra
PAPER_AGENT_REVIEW_MODEL=gpt-6-astra
PAPER_AGENT_REVIEW_REASONING_EFFORT=xhigh
# Optional per-response output budget; must be supported by the API provider.
# PAPER_AGENT_MAX_TOKENS=32768

# Optional Figure 1 image generation
PAPER_AGENT_ENABLE_IMAGE_FIGURE=false
PAPER_AGENT_IMAGE_API_KEY=your-api-key
PAPER_AGENT_IMAGE_BASE_URL=https://www.micuapi.ai/v1
PAPER_AGENT_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional Zotero Web API (read library + synced PDF files)
# Keys: https://www.zotero.org/settings/keys
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=users

# Set to the Zotero data directory to read local PDFs instead of Web API
ZOTERO_DATA_DIR=

# Required for WikiAgent: unified MinerU full-text, figure and caption parsing.
# Isolated MinerU 4.x environment; otherwise discover mineru-kit on PATH.
# PAPER_AGENT_MINERU_PYTHON=/path/to/mineru-venv/bin/python
# MINERU_HOME=/path/to/mineru/home
PAPER_AGENT_MINERU_TIMEOUT=1200
